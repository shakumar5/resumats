---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  keywords?: string;
  ogImage?: string;
  articleDate?: string;
  noindex?: boolean;
  faqData?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description = 'Free online resume builder with ATS score checker. Build ATS-friendly resumes, check resume score, optimize keywords, and generate cover letters. No sign-up, unlimited scans, 100% privacy.',
  canonicalURL,
  keywords = 'online resume builder with ATS score, ATS resume checker, free ATS resume builder, resume score checker online, ATS friendly resume builder free, AI resume builder, resume optimization tool online, resume keyword optimizer tool, resume maker online, free resume builder online, ATS resume format, resume parser tool',
  ogImage = '/og-image.svg',
  noindex = false,
  faqData = null
} = Astro.props;
const siteURL = 'https://onlineresumats.com';
const currentURL = canonicalURL || `${siteURL}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="ie=edge" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Online Resume ATS" />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="googlebot" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <!-- Noindex non-canonical domains (workers.dev, pages.dev) -->
  <script>
    if(location.hostname.includes('workers.dev')||location.hostname.includes('pages.dev')){
      document.querySelector('meta[name="robots"]').setAttribute('content','noindex, nofollow');
      document.querySelector('meta[name="googlebot"]').setAttribute('content','noindex, nofollow');
    }
  </script>
  <meta name="theme-color" content="#2563eb" />
  <link rel="canonical" href={currentURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap.xml" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={currentURL} />
  <meta property="og:site_name" content="Online Resume ATS" />
  <meta property="og:image" content={`${siteURL}${ogImage}`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteURL}${ogImage}`} />

  <!-- Structured Data - Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Online Resume ATS",
    "url": siteURL,
    "logo": `${siteURL}/favicon.svg`,
    "description": "Free ATS resume optimization tools - no sign-up, complete privacy, browser-based processing.",
    "sameAs": []
  })} />

  <!-- Structured Data - WebSite with SearchAction -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Online Resume ATS",
    "url": siteURL,
    "description": description,
    "publisher": {
      "@type": "Organization",
      "name": "Online Resume ATS"
    }
  })} />

  <!-- Structured Data - BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteURL
      },
      ...(Astro.url.pathname !== '/' ? [{
        "@type": "ListItem",
        "position": 2,
        "name": title.split(' - ')[0].split(' | ')[0],
        "item": currentURL
      }] : [])
    ]
  })} />

  <!-- Structured Data - FAQPage (if FAQ is present) -->
  {faqData && <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqData.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  })} />}

  <!-- Google AdSense -->
  <meta name="google-adsense-account" content="ca-pub-9843041963430696" />
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9843041963430696" crossorigin="anonymous"></script>

  <!-- Google Analytics (GA4) - loaded async, non-blocking -->
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-94DJ0GKP7W"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-94DJ0GKP7W');
  </script>

  <title>{title}</title>
</head>
<body class="min-h-screen bg-gray-50 text-gray-900 font-sans antialiased">
  <header class="bg-white border-b border-gray-100 sticky top-0 z-50 shadow-sm">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 bg-gradient-to-br from-primary-600 to-primary-700 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <span class="text-xl font-bold text-gray-900 group-hover:text-primary-600 transition-colors">Online Resume ATS</span>
        </a>

        <div class="hidden md:flex items-center gap-6">
          <a href="/ats-score-checker" class="text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors">ATS Checker</a>
          <a href="/cover-letter-generator" class="text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors">Cover Letter</a>
          <a href="/domain-converter" class="text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors">Domain Converter</a>
          <a href="/resume-keywords" class="text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors">Keywords</a>
        </div>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden pb-4">
        <div class="flex flex-col gap-2">
          <a href="/ats-score-checker" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">ATS Checker</a>
          <a href="/cover-letter-generator" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">Cover Letter</a>
          <a href="/domain-converter" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">Domain Converter</a>
          <a href="/resume-keywords" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">Keywords</a>
        </div>
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="bg-white border-t border-gray-100 mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="col-span-1 md:col-span-2">
          <a href="/" class="flex items-center gap-2 mb-4">
            <div class="w-8 h-8 bg-gradient-to-br from-primary-600 to-primary-700 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <span class="text-xl font-bold text-gray-900 hover:text-primary-600 transition-colors">Online Resume ATS</span>
          </a>
          <p class="text-gray-500 text-sm max-w-md">
            100% free ATS resume tools. No sign-up required, no data stored. All processing happens in your browser for complete privacy.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-gray-900 mb-3">Tools</h3>
          <ul class="space-y-2 text-sm text-gray-500">
            <li><a href="/ats-score-checker" class="hover:text-primary-600 transition-colors">ATS Score Checker</a></li>
            <li><a href="/cover-letter-generator" class="hover:text-primary-600 transition-colors">Cover Letter Generator</a></li>
            <li><a href="/domain-converter" class="hover:text-primary-600 transition-colors">Domain Converter</a></li>
            <li><a href="/resume-keywords" class="hover:text-primary-600 transition-colors">Keyword Analyzer</a></li>
          </ul>
        </div>

        <div>
          <h3 class="font-semibold text-gray-900 mb-3">Company</h3>
          <ul class="space-y-2 text-sm text-gray-500">
            <li><a href="/about" class="hover:text-primary-600 transition-colors">About</a></li>
            <li><a href="/privacy-policy" class="hover:text-primary-600 transition-colors">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-primary-600 transition-colors">Terms of Service</a></li>
            <li><a href="/contact" class="hover:text-primary-600 transition-colors">Contact</a></li>
          </ul>
        </div>
      </div>

      <div class="border-t border-gray-100 mt-8 pt-8 text-center text-sm text-gray-400">
        <p>&copy; {new Date().getFullYear()} Online Resume ATS. All rights reserved. Your data never leaves your browser.</p>
      </div>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });
  </script>
</body>
</html>
