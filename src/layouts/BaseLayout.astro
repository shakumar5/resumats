---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  keywords?: string;
  ogImage?: string;
  articleDate?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Free ATS resume tools - score checker, cover letter generator, domain converter & keyword analyzer. 100% free, no sign-up, complete privacy.',
  canonicalURL,
  keywords = 'ATS resume checker, free ATS score, resume keywords, cover letter generator, resume optimizer, applicant tracking system, job application tools, resume scanner, ATS-friendly resume, domain converter resume',
  ogImage = '/og-image.svg',
  noindex = false
} = Astro.props;
const siteURL = 'https://onlineresumats.com';
const currentURL = canonicalURL || `${siteURL}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="OnlineResumATS" />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="googlebot" content="index, follow" />
  <meta name="theme-color" content="#2563eb" />
  <link rel="canonical" href={currentURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={currentURL} />
  <meta property="og:site_name" content="OnlineResumATS" />
  <meta property="og:image" content={`${siteURL}${ogImage}`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteURL}${ogImage}`} />

  <!-- Structured Data - Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "OnlineResumATS",
    "url": siteURL,
    "logo": `${siteURL}/favicon.svg`,
    "description": "Free ATS resume optimization tools - no sign-up, complete privacy, browser-based processing.",
    "sameAs": []
  })} />

  <!-- Structured Data - WebSite with SearchAction -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "OnlineResumATS",
    "url": siteURL,
    "description": description,
    "publisher": {
      "@type": "Organization",
      "name": "OnlineResumATS"
    }
  })} />

  <!-- Structured Data - BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteURL
      },
      ...(Astro.url.pathname !== '/' ? [{
        "@type": "ListItem",
        "position": 2,
        "name": title.split(' - ')[0].split(' | ')[0],
        "item": currentURL
      }] : [])
    ]
  })} />

  <!-- Google AdSense (loaded after page render) -->
  <!-- Replace ca-pub-XXXXXXXXXXXXXXXX with your actual AdSense Publisher ID after approval -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>

  <!-- Google Analytics (GA4) - loaded async, non-blocking -->
  <!-- Replace G-XXXXXXXXXX with your actual GA4 Measurement ID -->
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
  </script>

  <title>{title}</title>
</head>
<body class="min-h-screen bg-gray-50 text-gray-900 font-sans antialiased">
  <header class="bg-white border-b border-gray-100 sticky top-0 z-50 shadow-sm">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 bg-gradient-to-br from-primary-600 to-primary-700 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <span class="text-xl font-bold text-gray-900 group-hover:text-primary-600 transition-colors">OnlineResumATS</span>
        </a>

        <div class="hidden md:flex items-center gap-6">
          <a href="/ats-score-checker" class="text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors">ATS Checker</a>
          <a href="/cover-letter-generator" class="text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors">Cover Letter</a>
          <a href="/domain-converter" class="text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors">Domain Converter</a>
          <a href="/resume-keywords" class="text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors">Keywords</a>
        </div>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden pb-4">
        <div class="flex flex-col gap-2">
          <a href="/ats-score-checker" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">ATS Checker</a>
          <a href="/cover-letter-generator" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">Cover Letter</a>
          <a href="/domain-converter" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">Domain Converter</a>
          <a href="/resume-keywords" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100">Keywords</a>
        </div>
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="bg-white border-t border-gray-100 mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="col-span-1 md:col-span-2">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-8 h-8 bg-gradient-to-br from-primary-600 to-primary-700 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <span class="text-xl font-bold">OnlineResumATS</span>
          </div>
          <p class="text-gray-500 text-sm max-w-md">
            100% free ATS resume tools. No sign-up required, no data stored. All processing happens in your browser for complete privacy.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-gray-900 mb-3">Tools</h3>
          <ul class="space-y-2 text-sm text-gray-500">
            <li><a href="/ats-score-checker" class="hover:text-primary-600 transition-colors">ATS Score Checker</a></li>
            <li><a href="/cover-letter-generator" class="hover:text-primary-600 transition-colors">Cover Letter Generator</a></li>
            <li><a href="/domain-converter" class="hover:text-primary-600 transition-colors">Domain Converter</a></li>
            <li><a href="/resume-keywords" class="hover:text-primary-600 transition-colors">Keyword Analyzer</a></li>
          </ul>
        </div>

        <div>
          <h3 class="font-semibold text-gray-900 mb-3">Company</h3>
          <ul class="space-y-2 text-sm text-gray-500">
            <li><a href="/about" class="hover:text-primary-600 transition-colors">About</a></li>
            <li><a href="/privacy-policy" class="hover:text-primary-600 transition-colors">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-primary-600 transition-colors">Terms of Service</a></li>
            <li><a href="/contact" class="hover:text-primary-600 transition-colors">Contact</a></li>
          </ul>
        </div>
      </div>

      <div class="border-t border-gray-100 mt-8 pt-8 text-center text-sm text-gray-400">
        <p>&copy; {new Date().getFullYear()} OnlineResumATS. All rights reserved. Your data never leaves your browser.</p>
      </div>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });
  </script>
</body>
</html>
