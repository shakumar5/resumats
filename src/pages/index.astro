---
import BaseLayout from '../layouts/BaseLayout.astro';
import { generateFAQSchema } from '../utils/seoUtils';

const faqData = [
  {
    question: "What is an ATS (Applicant Tracking System) and how does ATS score work?",
    answer: "An ATS (Applicant Tracking System) is recruiter resume screening software used by over 90% of companies to filter job applications. It scans resumes for relevant keywords, proper formatting, and job description matching. The ATS score represents how well your resume matches a specific job description — a higher score means your resume is more likely to pass the automated screening and reach a human recruiter."
  },
  {
    question: "Is this online resume builder with ATS score really free?",
    answer: "Yes, our ATS resume checker is 100% free with unlimited scans. No sign-up, no credit card, no hidden paywalls. Unlike competitors who limit you to 1-5 free scans, we offer unlimited resume analysis forever. Our free ATS resume builder tools process everything in your browser for complete privacy."
  },
  {
    question: "How to create an ATS friendly resume online?",
    answer: "To create an ATS friendly resume: use standard section headers (Experience, Education, Skills), include keywords from the job description, avoid tables/images/graphics, use a clean single-column layout, save as PDF, quantify achievements with numbers, and use our free resume score checker to validate your resume before applying."
  },
  {
    question: "Which resume format is best for ATS?",
    answer: "The reverse-chronological format is the best resume format for ATS systems. Use clear section headers, standard fonts, no columns or tables, and avoid headers/footers. A simple, clean PDF format works best. Our ATS resume format checker validates all these elements automatically."
  },
  {
    question: "How to improve ATS score of resume?",
    answer: "To improve your ATS score: match keywords from the job description exactly, use standard section headers, include both spelled-out terms and acronyms (e.g., 'Search Engine Optimization (SEO)'), add quantified achievements, remove graphics and complex formatting, and use our resume keyword optimizer tool to identify missing terms."
  },
  {
    question: "Can ATS reject good resumes?",
    answer: "Yes, ATS systems can reject well-qualified candidates if their resume isn't properly formatted or lacks specific keywords. Common reasons include using images/graphics, non-standard fonts, tables, missing keywords, creative formats, or saving in incompatible file types. Our free ATS resume checker helps identify and fix these issues before you apply."
  },
  {
    question: "What is the difference between an AI resume builder and an ATS resume checker?",
    answer: "An AI resume builder helps create resume content using artificial intelligence, while an ATS resume checker scores your existing resume against job descriptions for compatibility. Our tool combines both approaches — it analyzes your resume against ATS rules, suggests missing keywords, and helps optimize your content for maximum ATS compatibility, functioning as both a resume score checker and an AI resume improvement tool."
  },
  {
    question: "Does this tool work for freshers and experienced professionals?",
    answer: "Yes, our ATS resume tools work for everyone — fresh graduates, experienced professionals, career changers, and industry specialists. The ATS scoring engine adapts to any experience level, and our domain converter helps tailor resumes for specific industries like IT, banking, finance, marketing, and more."
  }
];
---

