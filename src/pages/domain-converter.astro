---
import ToolLayout from '../layouts/ToolLayout.astro';
import { domainKeywords } from '../data/domainKeywords';

const domains = Object.entries(domainKeywords).map(([key, val]) => ({
  key,
  name: val.name,
  description: val.description
}));
---

<ToolLayout
  title="Resume Domain Converter - Convert Resume for Any Industry | Online Resume ATS"
  description="Convert your resume for Fintech, Gaming, Healthcare, Education, Shipping, Cybersecurity, AI/ML, or E-Commerce. Unique tool that maps generic terms to industry-specific language. Free."
  heading="Domain Converter"
  subheading="Convert your resume's language to match your target industry"
  canonicalURL="https://onlineresumats.com/domain-converter"
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
    <!-- Input -->
    <div class="space-y-6">
      <!-- Domain Selection -->
      <div class="bg-white rounded-2xl border border-gray-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Target Industry</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="domain-grid">
          {domains.map((d) => (
            <button
              data-domain={d.key}
              class="domain-btn p-3 border-2 border-gray-200 rounded-xl text-center hover:border-purple-400 transition-all"
              title={d.description}
            >
              <span class="text-xs font-bold text-gray-900 block">{d.name.split(' ')[0]}</span>
            </button>
          ))}
        </div>
        <p id="domain-description" class="mt-3 text-sm text-gray-500 hidden"></p>
      </div>

      <!-- Resume Input -->
      <div class="bg-white rounded-2xl border border-gray-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Your Resume</h2>
        <div id="dc-upload-zone" class="border-2 border-dashed border-gray-300 rounded-xl p-6 text-center cursor-pointer hover:border-purple-400 hover:bg-purple-50 transition-all mb-3">
          <p class="text-sm text-gray-600"><span class="text-purple-600 font-medium">Upload PDF</span> or paste below</p>
          <input type="file" id="dc-resume-file" accept=".pdf" class="hidden" />
        </div>
        <textarea id="dc-resume-text" rows="10" placeholder="Paste your resume text here..." class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 resize-none"></textarea>
        <p id="dc-status" class="mt-2 text-sm hidden"></p>
      </div>

      <button id="convert-btn" class="w-full py-4 bg-purple-600 text-white font-semibold rounded-xl hover:bg-purple-700 transition-all shadow-lg shadow-purple-200 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
        Convert Resume
      </button>
    </div>

    <!-- Output -->
    <div class="space-y-6">
      <!-- Fit Score -->
      <div id="dc-score-card" class="bg-white rounded-2xl border border-gray-200 p-6 hidden">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Domain Fit Score</h2>
          <span id="dc-fit-score" class="text-2xl font-bold text-purple-600">0%</span>
        </div>
        <div class="mt-3 w-full h-3 bg-gray-200 rounded-full overflow-hidden">
          <div id="dc-fit-bar" class="h-full bg-purple-600 rounded-full transition-all duration-700" style="width: 0%"></div>
        </div>
        <p class="mt-2 text-xs text-gray-500">How well your current resume matches the target domain</p>
      </div>

      <!-- Changes -->
      <div id="dc-changes" class="bg-white rounded-2xl border border-gray-200 p-6 hidden">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Suggested Term Changes</h2>
        <div id="dc-changes-list" class="space-y-3"></div>
      </div>

      <!-- Suggested Keywords -->
      <div id="dc-keywords" class="bg-white rounded-2xl border border-gray-200 p-6 hidden">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Add These Keywords</h2>
        <div id="dc-keywords-list" class="flex flex-wrap gap-2"></div>
      </div>

      <!-- Suggested Skills -->
      <div id="dc-skills" class="bg-white rounded-2xl border border-gray-200 p-6 hidden">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Recommended Skills</h2>
        <div id="dc-skills-list" class="flex flex-wrap gap-2"></div>
      </div>

      <!-- Certifications -->
      <div id="dc-certs" class="bg-white rounded-2xl border border-gray-200 p-6 hidden">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Relevant Certifications</h2>
        <div id="dc-certs-list" class="flex flex-wrap gap-2"></div>
      </div>

      <!-- Action Verbs -->
      <div id="dc-verbs" class="bg-white rounded-2xl border border-gray-200 p-6 hidden">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Suggested Action Verbs</h2>
        <div id="dc-verbs-list" class="flex flex-wrap gap-2"></div>
      </div>

      <!-- Placeholder -->
      <div id="dc-placeholder" class="flex items-center justify-center">
        <div class="text-center p-12 bg-white rounded-2xl border border-gray-200 w-full">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
          <h3 class="text-lg font-medium text-gray-500 mb-2">Select a domain and paste your resume</h3>
          <p class="text-sm text-gray-400">We'll show you exactly what to change for your target industry</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { convertResume } from '../utils/domainConverter';

    let selectedDomain = '';
    let resumeText = '';

    // Domain selection
    document.querySelectorAll('.domain-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.domain-btn').forEach(b => {
          b.classList.remove('border-purple-500', 'bg-purple-50');
          b.classList.add('border-gray-200');
        });
        btn.classList.add('border-purple-500', 'bg-purple-50');
        btn.classList.remove('border-gray-200');
        selectedDomain = (btn as HTMLElement).dataset.domain || '';

        const desc = document.getElementById('domain-description') as HTMLElement;
        desc.classList.remove('hidden');
        desc.textContent = (btn as HTMLElement).title;

        updateConvertButton();
      });
    });

    // File upload
    const uploadZone = document.getElementById('dc-upload-zone') as HTMLElement;
    const fileInput = document.getElementById('dc-resume-file') as HTMLInputElement;
    const textArea = document.getElementById('dc-resume-text') as HTMLTextAreaElement;
    const status = document.getElementById('dc-status') as HTMLElement;

    uploadZone.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (file) {
        status.classList.remove('hidden');
        status.textContent = 'Parsing...';
        status.className = 'mt-2 text-sm text-blue-600';
        try {
          const { parsePDF } = await import('../utils/pdfParser');
          resumeText = await parsePDF(file);
          textArea.value = resumeText;
          status.textContent = '✓ Parsed';
          status.className = 'mt-2 text-sm text-green-600';
          updateConvertButton();
        } catch {
          status.textContent = 'Error parsing PDF';
          status.className = 'mt-2 text-sm text-red-600';
        }
      }
    });

    textArea.addEventListener('input', updateConvertButton);

    function updateConvertButton() {
      const btn = document.getElementById('convert-btn') as HTMLButtonElement;
      btn.disabled = !selectedDomain || !(textArea.value.trim() || resumeText);
    }

    // Convert
    document.getElementById('convert-btn')!.addEventListener('click', () => {
      const resume = textArea.value.trim() || resumeText;
      if (!resume || !selectedDomain) return;

      const result = convertResume(resume, selectedDomain);

      // Hide placeholder
      document.getElementById('dc-placeholder')!.classList.add('hidden');

      // Score
      const scoreCard = document.getElementById('dc-score-card') as HTMLElement;
      scoreCard.classList.remove('hidden');
      document.getElementById('dc-fit-score')!.textContent = result.domainFitScore + '%';
      (document.getElementById('dc-fit-bar') as HTMLElement).style.width = result.domainFitScore + '%';

      // Changes
      if (result.changes.length > 0) {
        const changesDiv = document.getElementById('dc-changes') as HTMLElement;
        changesDiv.classList.remove('hidden');
        document.getElementById('dc-changes-list')!.innerHTML = result.changes.map(c =>
          `<div class="flex items-center gap-3 p-3 bg-purple-50 rounded-lg">
            <span class="text-sm line-through text-gray-500">${c.original}</span>
            <svg class="w-4 h-4 text-purple-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
            <span class="text-sm font-medium text-purple-700">${c.suggested}</span>
          </div>`
        ).join('');
      }

      // Keywords
      if (result.suggestedKeywords.length > 0) {
        const kwDiv = document.getElementById('dc-keywords') as HTMLElement;
        kwDiv.classList.remove('hidden');
        document.getElementById('dc-keywords-list')!.innerHTML = result.suggestedKeywords.map(kw =>
          `<span class="px-3 py-1.5 bg-purple-100 text-purple-700 text-xs rounded-lg font-medium">${kw}</span>`
        ).join('');
      }

      // Skills
      if (result.suggestedSkills.length > 0) {
        const skillsDiv = document.getElementById('dc-skills') as HTMLElement;
        skillsDiv.classList.remove('hidden');
        document.getElementById('dc-skills-list')!.innerHTML = result.suggestedSkills.map(s =>
          `<span class="px-3 py-1.5 bg-blue-100 text-blue-700 text-xs rounded-lg font-medium">${s}</span>`
        ).join('');
      }

      // Certifications
      if (result.suggestedCertifications.length > 0) {
        const certsDiv = document.getElementById('dc-certs') as HTMLElement;
        certsDiv.classList.remove('hidden');
        document.getElementById('dc-certs-list')!.innerHTML = result.suggestedCertifications.map(c =>
          `<span class="px-3 py-1.5 bg-green-100 text-green-700 text-xs rounded-lg font-medium">${c}</span>`
        ).join('');
      }

      // Verbs
      if (result.suggestedActionVerbs.length > 0) {
        const verbsDiv = document.getElementById('dc-verbs') as HTMLElement;
        verbsDiv.classList.remove('hidden');
        document.getElementById('dc-verbs-list')!.innerHTML = result.suggestedActionVerbs.map(v =>
          `<span class="px-3 py-1.5 bg-orange-100 text-orange-700 text-xs rounded-lg font-medium">${v}</span>`
        ).join('');
      }
    });
  </script>
</ToolLayout>
